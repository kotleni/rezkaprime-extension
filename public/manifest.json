{
  "manifest_version": 3,
  "name": "Rezka Prime",
  "version": "1.0.0",
  "description": "Jet another HDRezka extension.",
  "icons": {
    "48": "icon48.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_icon": "icon48.png",
    "default_title": "RezkaPrime",
    "default_popup": "index.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["assets/styles.css"],
      "world" : "MAIN"
    }
  ]
}